<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="MCP Post-Sync Smoke" verbose="1">
    <!-- Fast file-level verification after validation/mcp artifacts are copied or regenerated. -->
    <listeners>
        <listener class-name="com.ai.skills.mcp.tests.support.McpPackageAuditSuiteInterceptor"/>
    </listeners>
    <test name="mcp-post-sync-smoke">
        <classes>
            <class name="com.ai.skills.mcp.tests.smoke.McpPostSyncSmokeContractTest">
                <methods>
                    <include name="requiredFrozenMcpArtifactsArePresent"/>
                    <include name="finalReportLinksFrozenMcpAndKpiEvidence"/>
                    <include name="finalReportShowsSanitizedMavenCloseoutCommandAndOriginLink"/>
                    <include name="extentOriginMatchesFrozenExtentReportHashSizeAndExit"/>
                    <include name="frozenTestNgXmlIsGreenAndCounted"/>
                    <include name="gateResultAndFinalReportAgreeWithGreenCloseoutCounts"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
