<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="MCP Final Report Close-Out" verbose="1">
    <!-- Surface gate: run after package-closeout artifacts are frozen; semantic LangGraph validation follows separately. -->
    <listeners>
        <listener class-name="com.endava.ai.skills.mcp.tests.support.McpPackageAuditSuiteInterceptor"/>
    </listeners>
    <test name="mcp-final-report-closeout">
        <classes>
            <class name="com.endava.ai.skills.mcp.tests.smoke.McpPostSyncSmokeContractTest">
                <methods>
                    <include name="requiredFrozenMcpArtifactsArePresent"/>
                    <include name="finalReportLinksFrozenMcpAndKpiEvidence"/>
                    <include name="finalReportShowsSanitizedMavenCloseoutCommandAndOriginLink"/>
                    <include name="extentOriginMatchesFrozenExtentReportHashSizeAndExit"/>
                    <include name="frozenTestNgXmlIsGreenAndCounted"/>
                    <include name="gateResultAndFinalReportAgreeWithGreenCloseoutCounts"/>
                </methods>
            </class>
            <class name="com.endava.ai.skills.mcp.tests.latest.McpLatestPackageLinkContractTest">
                <methods>
                    <include name="everyLocalHrefInFinalReportResolves"/>
                    <include name="savedLinkAuditReportsNoMissingLinks"/>
                </methods>
            </class>
            <class name="com.endava.ai.skills.mcp.tests.latest.report.McpLatestPackageReportPresentationContractTest">
                <methods>
                    <include name="finalReportUsesSharedCssAndDocumentChrome"/>
                    <include name="finalReportUsesHtmlExampleVisualShell"/>
                    <include name="finalReportMainSectionsAreCollapsibleWithOnlyGraphOpen"/>
                </methods>
            </class>
            <class name="com.endava.ai.skills.mcp.tests.core.McpExtentScreenshotBrowserVisibilityContractTest"/>
        </classes>
    </test>
</suite>
