<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="MCP Candidate Gate" verbose="1">
    <!-- Promotion gate: run only after package-closeout and final-report-closeout already passed. -->
    <listeners>
        <listener class-name="com.endava.ai.skills.mcp.tests.support.McpPackageAuditSuiteInterceptor"/>
    </listeners>
    <test name="candidate">
        <classes>
            <class name="com.endava.ai.skills.mcp.tests.candidate.McpCandidateContractTest">
                <methods>
                    <include name="latestPackageIsTeacherGradeHtmlExampleCandidate"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
