<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ATF Core Parallel Reporting Visual Zoom Slice" verbose="1">
    <listeners>
        <listener class-name="com.endava.ai.atf.core.reporting.aggregate.AtfCoreAggregateReportListener"/>
    </listeners>
    <test name="core-reporting-visual-zoom">
        <groups>
            <run>
                <exclude name="allure-only"/>
                <exclude name="controlled-failure-fixture"/>
                <exclude name="aggregate-published-artifact-audit"/>
            </run>
        </groups>
        <classes>
            <class name="com.endava.ai.atf.core.reporting.window.UIZoomRuntimeReportingContractTest"/>
        </classes>
    </test>
</suite>
