<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ATF Core Parallel Support Skills Slice" verbose="1">
    <listeners>
        <listener class-name="com.ai.atf.core.reporting.aggregate.AtfCoreAggregateReportListener"/>
    </listeners>
    <test name="core-support-skills">
        <groups>
            <run>
                <exclude name="allure-only"/>
                <exclude name="controlled-failure-fixture"/>
                <exclude name="aggregate-published-artifact-audit"/>
            </run>
        </groups>
        <packages>
            <package name="com.ai.atf.core.support.*"/>
            <package name="com.ai.atf.core.skills.*"/>
        </packages>
    </test>
</suite>
