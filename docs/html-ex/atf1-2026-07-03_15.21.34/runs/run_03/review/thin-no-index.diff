+package com.endava.ai.ui.tests.refunds.support;
+
+import com.endava.ai.ui.core.runtime.BaseTestUI;
+import com.endava.ai.ui.support.model.RefundSupportRequestContext;
+import com.endava.ai.ui.support.validation.support.RefundSupportRequestValidation;
+import org.testng.annotations.Test;
+
+import static com.endava.ai.ui.tests.refunds.support.RefundSupportRequestTestSupport.adminProgressedRequest;
+import static com.endava.ai.ui.tests.refunds.support.RefundSupportRequestTestSupport.request;
+
+public final class RefundSupportCustomerMessagesLifecycleTest extends BaseTestUI {
+    private final RefundSupportRequestValidation validation = new RefundSupportRequestValidation();
+
+    @Test(description = "Refund support message API returns durable case identity.",
+            groups = {"ui.refund-support", "ui.customer-messages", "ui.business"})
+    public void refundSupportMessageApiCreatesDurableCaseIdentity() {
+        RefundSupportRequestContext context = request();
+
+        validation.assertMessagesApiCreatedDurableMessageIdentity(context);
+    }
+
+    @Test(description = "Refund support message starts from explicit NEW case state.",
+            groups = {"ui.refund-support", "ui.customer-messages", "ui.business"})
+    public void refundSupportMessageApiCreatesNewCaseState() {
+        RefundSupportRequestContext context = request();
+
+        validation.assertMessagesApiCreatedNewSupportCase(context);
+    }
+
+    @Test(description = "Customer account exposes the support messages route after request creation.",
+            groups = {"ui.refund-support", "ui.customer-messages", "ui.business"})
+    public void refundSupportCustomerAccountExposesMessagesRoute() {
+        RefundSupportRequestContext context = request();
+
+        validation.assertCustomerMessagesSurfaceIsAccountScoped(context);
+    }
+
+    @Test(description = "Customer messages page shows the created refund support request.",
+            groups = {"ui.refund-support", "ui.customer-messages", "ui.business"})
+    public void refundSupportCustomerMessagesShowCreatedRequest() {
+        RefundSupportRequestContext context = adminProgressedRequest();
+
+        validation.assertCustomerMessagesSurfaceShowsCreatedRequest(context);
+    }
+
+    @Test(description = "Customer-visible support request keeps invoice, subject and status in one proof chain.",
+            groups = {"ui.refund-support", "ui.customer-messages", "ui.business"})
+    public void refundSupportCustomerVisibleLifecycleConnectsInvoiceSubjectAndStatus() {
+        RefundSupportRequestContext context = adminProgressedRequest();
+
+        validation.assertInvoiceBackedRefundMessage(context);
+        validation.assertMessagesApiCreatedDurableMessageIdentity(context);
+        validation.assertMessagesApiCreatedNewSupportCase(context);
+        validation.assertAdminReplyProgressesSupportCase(context);
+        validation.assertCustomerMessagesSurfaceShowsCreatedRequest(context);
+    }
+}
