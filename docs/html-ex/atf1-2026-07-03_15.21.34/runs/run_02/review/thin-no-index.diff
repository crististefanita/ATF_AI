+package com.endava.ai.ui.support.service;
+
+import com.endava.ai.core.support.config.ConfigManager;
+import com.endava.ai.core.reporting.StepLogger;
+import com.endava.ai.ui.support.model.CustomerData;
+
+import java.io.IOException;
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.time.Duration;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+public final class SupportMessagesClient {
+    private static final String ADMIN_EMAIL = "admin@practicesoftwaretesting.com";
+    private static final String ADMIN_PASSWORD = "welcome01";
+    private static final Pattern STRING_FIELD = Pattern.compile("\"%s\"\\s*:\\s*\"([^\"]*)\"");
+
+    private final HttpClient http = HttpClient.newBuilder()
+            .connectTimeout(Duration.ofSeconds(10))
+            .build();
+
+    public SupportMessageReply replyAsAdmin(String messageId, String replyMessage) {
+        String token = login(ADMIN_EMAIL, ADMIN_PASSWORD);
+        HttpResponse<String> response = send(post("/messages/" + messageId + "/reply", token,
+                "{\"message\":\"" + json(replyMessage) + "\"}"));
+        requireStatus(response, 201, "admin support reply");
+        SupportMessageReply reply = new SupportMessageReply(
+                firstField(response.body(), "id"),
+                firstField(response.body(), "message"),
+                firstField(response.body(), "created_at"),
+                response.body()
+        );
+        logDetail("adminReplyBody=" + response.body());
+        return reply;
+    }
+
+    public SupportMessageCase readCustomerMessage(CustomerData customer, String messageId) {
+        String token = login(customer.getEmail(), customer.getPassword());
+        HttpResponse<String> response = send(get("/messages/" + messageId, token));
+        requireStatus(response, 200, "customer support message detail");
+        return new SupportMessageCase(
+                firstField(response.body(), "id"),
+                firstField(response.body(), "status"),
+                firstField(response.body(), "subject"),
+                firstField(response.body(), "message"),
+                response.body()
+        );
+    }
+
+    public String readCustomerMessages(CustomerData customer) {
+        String token = login(customer.getEmail(), customer.getPassword());
+        HttpResponse<String> response = send(get("/messages", token));
+        requireStatus(response, 200, "customer support messages list");
+        logDetail("customerMessagesBody=" + response.body());
+        return response.body();
+    }
+
+    private String login(String email, String password) {
+        HttpResponse<String> response = send(post("/users/login", null,
+                "{\"email\":\"" + json(email) + "\",\"password\":\"" + json(password) + "\"}"));
+        requireStatus(response, 200, "support message login for " + email);
+        String token = firstField(response.body(), "access_token");
+        if (token.isBlank()) {
+            throw new AssertionError("Expected login response to include access_token. Body: " + response.body());
+        }
+        return token;
+    }
+
+    private HttpRequest get(String path, String token) {
+        HttpRequest.Builder builder = HttpRequest.newBuilder(uri(path))
+                .timeout(Duration.ofSeconds(20))
+                .GET();
+        authorize(builder, token);
+        return builder.build();
+    }
+
+    private HttpRequest post(String path, String token, String body) {
+        HttpRequest.Builder builder = HttpRequest.newBuilder(uri(path))
+                .timeout(Duration.ofSeconds(20))
+                .header("Content-Type", "application/json")
+                .POST(HttpRequest.BodyPublishers.ofString(body));
+        authorize(builder, token);
+        return builder.build();
+    }
+
+    private void authorize(HttpRequest.Builder builder, String token) {
+        if (token != null && !token.isBlank()) {
+            builder.header("Authorization", "Bearer " + token);
+        }
+    }
+
+    private URI uri(String path) {
+        return URI.create(apiBaseUrl() + path);
+    }
+
+    private String apiBaseUrl() {
+        String uiBaseUrl = ConfigManager.require("base.url");
+        if (uiBaseUrl.contains("practicesoftwaretesting.com")) {
+            return "https://api.practicesoftwaretesting.com";
+        }
+        return ConfigManager.get("base.url.api", "https://api.practicesoftwaretesting.com");
+    }
+
+    private HttpResponse<String> send(HttpRequest request) {
+        try {
+            return http.send(request, HttpResponse.BodyHandlers.ofString());
+        } catch (IOException e) {
+            throw new AssertionError("HTTP call failed: " + request.method() + " " + request.uri(), e);
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            throw new AssertionError("Interrupted during HTTP call: " + request.method() + " " + request.uri(), e);
+        }
+    }
+
+    private void requireStatus(HttpResponse<String> response, int expected, String action) {
+        if (response.statusCode() != expected) {
+            throw new AssertionError("Expected " + action + " to return " + expected
+                    + " but was " + response.statusCode() + ". Body: " + response.body());
+        }
+    }
+
+    private String firstField(String json, String fieldName) {
+        Pattern pattern = Pattern.compile(String.format(STRING_FIELD.pattern(), Pattern.quote(fieldName)));
+        Matcher matcher = pattern.matcher(json == null ? "" : json);
+        return matcher.find() ? matcher.group(1) : "";
+    }
+
+    private String json(String value) {
+        return value == null ? "" : value.replace("\\", "\\\\").replace("\"", "\\\"");
+    }
+
+    private void logDetail(String detail) {
+        try {
+            StepLogger.logDetail(detail);
+        } catch (IllegalStateException ignored) {
+        }
+    }
+
+    public static final class SupportMessageReply {
+        private final String id;
+        private final String message;
+        private final String createdAt;
+        private final String body;
+
+        public SupportMessageReply(String id, String message, String createdAt, String body) {
+            this.id = id;
+            this.message = message;
+            this.createdAt = createdAt;
+            this.body = body;
+        }
+
+        public String id() {
+            return id;
+        }
+
+        public String message() {
+            return message;
+        }
+
+        public String createdAt() {
+            return createdAt;
+        }
+
+        public String body() {
+            return body;
+        }
+    }
+
+    public static final class SupportMessageCase {
+        private final String id;
+        private final String status;
+        private final String subject;
+        private final String message;
+        private final String body;
+
+        public SupportMessageCase(String id, String status, String subject, String message, String body) {
+            this.id = id;
+            this.status = status;
+            this.subject = subject;
+            this.message = message;
+            this.body = body;
+        }
+
+        public String id() {
+            return id;
+        }
+
+        public String status() {
+            return status;
+        }
+
+        public String subject() {
+            return subject;
+        }
+
+        public String message() {
+            return message;
+        }
+
+        public String body() {
+            return body;
+        }
+    }
+}
