+package com.endava.ai.ui.tests.support;
+
+import com.endava.ai.ui.core.DriverManager;
+import com.endava.ai.ui.model.ProfileSnapshot;
+import com.endava.ai.ui.model.RegistrationData;
+import com.endava.ai.ui.pages.AccountPage;
+import com.endava.ai.ui.pages.ProfilePage;
+import com.endava.ai.ui.service.RegistrationService;
+import com.endava.ai.ui.utils.DataGenerator;
+import com.endava.ai.ui.utils.UIActions;
+import com.endava.ai.ui.utils.WaitUtils;
+
+import java.time.Duration;
+
+public final class ProfileService {
+    private final RegistrationService registrationService = new RegistrationService();
+    private final LoginService loginService = new LoginService();
+
+    public ProfileSnapshot registerLoginAndOpenProfile() {
+        UIActions.clearSession();
+        RegistrationData customer = registerCustomerWithRetry();
+        WaitUtils.pause(Duration.ofSeconds(4));
+        loginService.openLogin();
+        loginService.login(customer.email(), customer.password());
+        openProfile();
+        return new ProfileSnapshot(customer);
+    }
+
+    public void openProfile() {
+        UIActions.navigateToRelative("/account/profile");
+        WaitUtils.waitForVisible(ProfilePage.APP_PROFILE);
+        WaitUtils.waitForVisible(ProfilePage.UPDATE_PROFILE);
+    }
+
+    public void openProfileFromAccountMenu() {
+        UIActions.navigateToRelative("/account");
+        WaitUtils.waitForVisible(AccountPage.NAV_MENU);
+        UIActions.click(AccountPage.NAV_MENU, "Account menu");
+        UIActions.click(AccountPage.PROFILE_NAV, "Profile");
+        WaitUtils.waitForVisible(ProfilePage.APP_PROFILE);
+    }
+
+    public void reloginAndOpenProfile(ProfileSnapshot snapshot) {
+        loginService.signOut();
+        loginService.openLogin();
+        loginService.login(snapshot.customer().email(), snapshot.customer().password());
+        openProfile();
+    }
+
+    public void attemptProfileUpdate() {
+        UIActions.type(ProfilePage.FIRST_NAME, "First name", "Edited");
+        UIActions.type(ProfilePage.PHONE, "Phone", "40722999111");
+        UIActions.type(ProfilePage.STREET, "Street", "Edited Lane 42");
+        UIActions.type(ProfilePage.CITY, "City", "Brasov");
+        UIActions.click(ProfilePage.UPDATE_PROFILE, "Update Profile");
+        WaitUtils.pause(Duration.ofSeconds(2));
+        openProfile();
+    }
+
+    private RegistrationData registerCustomerWithRetry() {
+        RegistrationData customer = profileCustomer();
+        for (int attempt = 1; attempt <= 3; attempt++) {
+            registrationService.openRegister();
+            registrationService.register(customer);
+            String outcome = WaitUtils.waitUntil(
+                    this::registrationOutcome,
+                    value -> value.contains("/auth/login")
+                            || value.contains("data leak")
+                            || value.contains("already exists"),
+                    Duration.ofSeconds(25),
+                    Duration.ofMillis(300)
+            );
+            if (outcome.contains("/auth/login")) {
+                return customer;
+            }
+            customer = profileCustomer();
+        }
+        throw new AssertionError("Registration did not reach login after retries. Last URL: "
+                + DriverManager.getEngine().getCurrentUrl());
+    }
+
+    private String registrationOutcome() {
+        String url = DriverManager.getEngine().getCurrentUrl();
+        if (url.contains("/auth/login")) {
+            return url;
+        }
+        try {
+            return url + " " + DriverManager.getEngine().getText("body").toLowerCase();
+        } catch (Exception ignored) {
+            return url;
+        }
+    }
+
+    private RegistrationData profileCustomer() {
+        return RegistrationData.builder()
+                .firstName("Codex")
+                .lastName("Profile")
+                .dob("1990-01-01")
+                .street("Memory Street")
+                .postal("010101")
+                .houseNumber("7")
+                .city("Bucharest")
+                .state("Bucharest")
+                .country("RO")
+                .phone("40722123456")
+                .email(DataGenerator.uniqueEmail())
+                .password(DataGenerator.strongPassword())
+                .build();
+    }
+}
