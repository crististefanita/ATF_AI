+package com.endava.ai.ui.validation;
+
+import com.endava.ai.core.reporting.StepLogger;
+import com.endava.ai.ui.model.ProfileSnapshot;
+import com.endava.ai.ui.pages.ProfilePage;
+import com.endava.ai.ui.utils.UIActions;
+import com.endava.ai.ui.utils.WaitUtils;
+import org.testng.Assert;
+
+import java.time.Duration;
+
+public final class ProfileValidation {
+    public void assertProfileRecord(ProfileSnapshot snapshot) {
+        StepLogger.startStep("Verify registered customer profile record");
+        waitForFirstName(snapshot);
+        assertValue(ProfilePage.FIRST_NAME, "First name", snapshot.customer().firstName());
+        assertValue(ProfilePage.LAST_NAME, "Last name", snapshot.customer().lastName());
+        assertValue(ProfilePage.EMAIL, "Email", snapshot.customer().email());
+        assertValue(ProfilePage.PHONE, "Phone", snapshot.customer().phone());
+        assertValue(ProfilePage.STREET, "Street", snapshot.customer().street());
+        assertValue(ProfilePage.POSTAL_CODE, "Postal code", snapshot.customer().postal());
+        assertValue(ProfilePage.CITY, "City", snapshot.customer().city());
+        assertValue(ProfilePage.STATE, "State", snapshot.customer().state());
+        assertValue(ProfilePage.COUNTRY, "Country", snapshot.customer().country());
+        StepLogger.pass("Profile form rehydrates the registered customer identity and address.");
+    }
+
+    public void assertProfileSurface() {
+        StepLogger.startStep("Verify profile surface is account owned");
+        String body = UIActions.getText(ProfilePage.BODY, "Profile body");
+        Assert.assertTrue(body.contains("Profile"), "Expected Profile title.");
+        Assert.assertTrue(body.contains("Update Profile"), "Expected update profile action.");
+        Assert.assertTrue(body.contains("Password"), "Expected password section.");
+        StepLogger.pass("Account profile exposes profile and credential surfaces.");
+    }
+
+    public void assertPasswordBoundaryFieldsAreBlank() {
+        StepLogger.startStep("Verify password fields are empty boundary fields");
+        assertValue(ProfilePage.CURRENT_PASSWORD, "Current password", "");
+        assertValue(ProfilePage.NEW_PASSWORD, "New password", "");
+        assertValue(ProfilePage.NEW_PASSWORD_CONFIRM, "Confirm password", "");
+        StepLogger.pass("Password fields are visible boundary controls, not persisted profile data.");
+    }
+
+    public void assertUpdateDoesNotOverwriteProfileRecord(ProfileSnapshot snapshot) {
+        StepLogger.startStep("Verify profile update boundary does not overwrite the registered record");
+        assertProfileRecord(snapshot);
+        StepLogger.pass("Profile update remains a boundary; registered record is still the owned object.");
+    }
+
+    private void waitForFirstName(ProfileSnapshot snapshot) {
+        WaitUtils.waitForInputValue(
+                ProfilePage.FIRST_NAME,
+                "profile first name",
+                value -> snapshot.customer().firstName().equals(value),
+                Duration.ofSeconds(20)
+        );
+    }
+
+    private void assertValue(String selector, String label, String expected) {
+        String value = UIActions.getValue(selector, label);
+        StepLogger.logDetail(label + "=" + value);
+        Assert.assertEquals(value, expected, "Expected profile value for " + label);
+    }
+}
