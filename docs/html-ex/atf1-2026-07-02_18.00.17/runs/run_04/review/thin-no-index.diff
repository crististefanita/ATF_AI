+package com.endava.ai.ui.tests.refunds.support;
+
+import com.endava.ai.ui.support.flows.support.RefundSupportRequestFlow;
+import com.endava.ai.ui.support.model.RefundSupportRequestContext;
+
+final class RefundSupportRequestTestSupport {
+    private static final RefundSupportRequestFlow FLOW = new RefundSupportRequestFlow();
+    private static RefundSupportRequestContext request;
+    private static RefundSupportRequestContext adminProgressedRequest;
+    private static RefundSupportRequestContext reopenedRequest;
+
+    private RefundSupportRequestTestSupport() {
+    }
+
+    static RefundSupportRequestContext request() {
+        if (request == null) {
+            request = FLOW.createRefundSupportRequestForPurchasedInvoice();
+        }
+        return request;
+    }
+
+    static RefundSupportRequestContext reopenedRequest() {
+        if (reopenedRequest == null) {
+            reopenedRequest = FLOW.reopenSubmittedRequest(request());
+        }
+        return reopenedRequest;
+    }
+
+    static RefundSupportRequestContext adminProgressedRequest() {
+        if (adminProgressedRequest == null) {
+            adminProgressedRequest = FLOW.progressRequestWithAdminReplyAndOpenCustomerMessages(request());
+        }
+        return adminProgressedRequest;
+    }
+}
