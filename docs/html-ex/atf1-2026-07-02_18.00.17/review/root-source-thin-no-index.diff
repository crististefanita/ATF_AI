+package com.ai.ui.support.model;
+
+import com.ai.ui.core.engine.UiNetworkResponse;
+import lombok.Getter;
+
+@Getter
+public final class RefundSupportRequestContext {
+    private final AccountInvoiceContext invoice;
+    private final String subject;
+    private final String message;
+    private final String contactBodyBeforeSubmit;
+    private final String contactBodyAfterSubmit;
+    private final String contactUrl;
+    private final UiNetworkResponse messageResponse;
+    private final String messageId;
+    private final String messageStatus;
+    private final String messageCreatedAt;
+    private final String accountMessagesBody;
+    private final String accountMessagesUrl;
+    private final String adminReplyId;
+    private final String adminReplyMessage;
+    private final String adminReplyCreatedAt;
+    private final String customerMessageStatusAfterAdminReply;
+    private final String customerMessagesApiBodyAfterAdminReply;
+    private final String customerMessagesBodyAfterAdminReply;
+    private final String customerMessagesUrlAfterAdminReply;
+
+    public RefundSupportRequestContext(AccountInvoiceContext invoice,
+                                       String subject,
+                                       String message,
+                                       String contactBodyBeforeSubmit,
+                                       String contactBodyAfterSubmit,
+                                       String contactUrl,
+                                       UiNetworkResponse messageResponse,
+                                       String messageId,
+                                       String messageStatus,
+                                       String messageCreatedAt,
+                                       String accountMessagesBody,
+                                       String accountMessagesUrl) {
+        this(invoice, subject, message, contactBodyBeforeSubmit, contactBodyAfterSubmit, contactUrl, messageResponse,
+                messageId, messageStatus, messageCreatedAt, accountMessagesBody, accountMessagesUrl,
+                "", "", "", "", "", "", "");
+    }
+
+    public RefundSupportRequestContext(AccountInvoiceContext invoice,
+                                       String subject,
+                                       String message,
+                                       String contactBodyBeforeSubmit,
+                                       String contactBodyAfterSubmit,
+                                       String contactUrl,
+                                       UiNetworkResponse messageResponse,
+                                       String messageId,
+                                       String messageStatus,
+                                       String messageCreatedAt,
+                                       String accountMessagesBody,
+                                       String accountMessagesUrl,
+                                       String adminReplyId,
+                                       String adminReplyMessage,
+                                       String adminReplyCreatedAt,
+                                       String customerMessageStatusAfterAdminReply,
+                                       String customerMessagesApiBodyAfterAdminReply,
+                                       String customerMessagesBodyAfterAdminReply,
+                                       String customerMessagesUrlAfterAdminReply) {
+        this.invoice = invoice;
+        this.subject = subject;
+        this.message = message;
+        this.contactBodyBeforeSubmit = contactBodyBeforeSubmit;
+        this.contactBodyAfterSubmit = contactBodyAfterSubmit;
+        this.contactUrl = contactUrl;
+        this.messageResponse = messageResponse;
+        this.messageId = messageId;
+        this.messageStatus = messageStatus;
+        this.messageCreatedAt = messageCreatedAt;
+        this.accountMessagesBody = accountMessagesBody;
+        this.accountMessagesUrl = accountMessagesUrl;
+        this.adminReplyId = adminReplyId;
+        this.adminReplyMessage = adminReplyMessage;
+        this.adminReplyCreatedAt = adminReplyCreatedAt;
+        this.customerMessageStatusAfterAdminReply = customerMessageStatusAfterAdminReply;
+        this.customerMessagesApiBodyAfterAdminReply = customerMessagesApiBodyAfterAdminReply;
+        this.customerMessagesBodyAfterAdminReply = customerMessagesBodyAfterAdminReply;
+        this.customerMessagesUrlAfterAdminReply = customerMessagesUrlAfterAdminReply;
+    }
+
+    public String getInvoiceNumber() {
+        return invoice.getInvoiceNumber();
+    }
+
+    public String getCustomerEmail() {
+        return invoice.getCustomer().getEmail();
+    }
+
+    public String getRequestedAmount() {
+        return invoice.getCartTotal();
+    }
+}
diff --git a/src/main/java/com/ai/ui/support/service/SupportMessagesClient.java b/src/main/java/com/ai/ui/support/service/SupportMessagesClient.java
