+package com.endava.ai.ui.support.model.invoice;
+
+import com.endava.ai.ui.support.model.CustomerData;
+
+public final class AccountInvoiceSnapshot {
+    private final CustomerData customer;
+    private final String productName;
+    private final String productUnitPrice;
+    private final int quantity;
+    private final String cartTotal;
+    private final String paymentMethod;
+    private final String invoiceNumber;
+
+    public AccountInvoiceSnapshot(CustomerData customer,
+                                  String productName,
+                                  String productUnitPrice,
+                                  int quantity,
+                                  String cartTotal,
+                                  String paymentMethod,
+                                  String invoiceNumber) {
+        this.customer = customer;
+        this.productName = productName;
+        this.productUnitPrice = productUnitPrice;
+        this.quantity = quantity;
+        this.cartTotal = cartTotal;
+        this.paymentMethod = paymentMethod;
+        this.invoiceNumber = invoiceNumber;
+    }
+
+    public CustomerData getCustomer() {
+        return customer;
+    }
+
+    public String getProductName() {
+        return productName;
+    }
+
+    public String getProductUnitPrice() {
+        return productUnitPrice;
+    }
+
+    public int getQuantity() {
+        return quantity;
+    }
+
+    public String getCartTotal() {
+        return cartTotal;
+    }
+
+    public String getPaymentMethod() {
+        return paymentMethod;
+    }
+
+    public String getInvoiceNumber() {
+        return invoiceNumber;
+    }
+}
