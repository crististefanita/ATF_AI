+        documentValidation.assertInvoiceDocumentDetailsKeepPaymentMethod(documentFixture.createdInvoiceDocument());
+    }
+
+    @Test
+    public void invoice_document_response_names_invoice() {
+        documentValidation.assertInvoiceDocumentResponseNamesInvoice(documentFixture.createdInvoiceDocument());
+        documentValidation.assertInvoicePdfArtifactHasBinaryBoundaries(documentFixture.createdInvoiceDocument());
+    }
+}
