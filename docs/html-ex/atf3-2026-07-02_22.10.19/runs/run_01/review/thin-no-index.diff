+package com.endava.ai.ui.tests.fixture.invoice;
+
+import com.endava.ai.ui.support.flows.invoice.RegisteredInvoiceFlow;
+import com.endava.ai.ui.support.model.invoice.AccountInvoiceDocumentSnapshot;
+import com.endava.ai.ui.support.model.invoice.AccountInvoiceSnapshot;
+
+import java.util.function.Supplier;
+
+public final class RegisteredInvoiceFixture {
+    private final RegisteredInvoiceFlow flow = new RegisteredInvoiceFlow();
+    private AccountInvoiceSnapshot snapshot;
+    private AccountInvoiceDocumentSnapshot createdDocument;
+    private AccountInvoiceDocumentSnapshot reopenedDocument;
+    private AccountInvoiceDocumentSnapshot reloggedDocument;
+
+    public AccountInvoiceSnapshot createdInvoice() {
+        return ensureInvoiceOpen();
+    }
+
+    public AccountInvoiceSnapshot reopenedInvoice() {
+        AccountInvoiceSnapshot invoice = ensureInvoiceOpen();
+        flow.reopenAccountInvoices();
+        return invoice;
+    }
+
+    public AccountInvoiceSnapshot reloggedInvoice() {
+        AccountInvoiceSnapshot invoice = ensureInvoiceOpen();
+        flow.reloginAndOpenAccountInvoices(invoice);
+        return invoice;
+    }
+
+    public AccountInvoiceDocumentSnapshot createdInvoiceDocument() {
+        createdDocument = documentOrCreate(createdDocument, this::createdInvoice);
+        return createdDocument;
+    }
+
+    public AccountInvoiceDocumentSnapshot reopenedInvoiceDocument() {
+        reopenedDocument = documentOrCreate(reopenedDocument, this::reopenedInvoice);
+        return reopenedDocument;
+    }
+
+    public AccountInvoiceDocumentSnapshot reloggedInvoiceDocument() {
+        reloggedDocument = documentOrCreate(reloggedDocument, this::reloggedInvoice);
+        return reloggedDocument;
+    }
+
+    private AccountInvoiceSnapshot ensureInvoiceOpen() {
+        if (snapshot == null) {
+            snapshot = flow.createInvoiceAndOpenAccountInvoices();
+        } else {
+            flow.openInvoicesFor(snapshot);
+        }
+        return snapshot;
+    }
+
+    private AccountInvoiceDocumentSnapshot documentOrCreate(AccountInvoiceDocumentSnapshot existing,
+                                                           Supplier<AccountInvoiceSnapshot> supplier) {
+        return existing == null ? flow.openInvoiceDocument(supplier.get()) : existing;
+    }
+}
