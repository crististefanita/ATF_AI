+package com.ai.ui.support.model.invoice;
+
+public final class AccountInvoicePdfArtifact {
+    private final String url;
+    private final int status;
+    private final String contentType;
+    private final int byteLength;
+    private final String header;
+    private final String trailer;
+
+    public AccountInvoicePdfArtifact(String url,
+                                     int status,
+                                     String contentType,
+                                     int byteLength,
+                                     String header,
+                                     String trailer) {
+        this.url = url;
+        this.status = status;
+        this.contentType = contentType;
+        this.byteLength = byteLength;
+        this.header = header;
+        this.trailer = trailer;
+    }
+
+    public String getUrl() {
+        return url;
+    }
+
+    public int getStatus() {
+        return status;
+    }
+
+    public String getContentType() {
+        return contentType;
+    }
+
+    public int getByteLength() {
+        return byteLength;
+    }
+
+    public String getHeader() {
+        return header;
+    }
+
+    public String getTrailer() {
+        return trailer;
+    }
+
+    public boolean isSuccess() {
+        return status >= 200 && status < 300;
+    }
+
+    public boolean hasPdfBoundaries() {
+        return header.startsWith("%PDF-") && trailer.contains("%%EOF");
+    }
+}
