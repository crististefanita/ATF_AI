+package com.ai.ui.tests.invoice.account.document;
+
+import com.ai.ui.core.runtime.BaseTestUI;
+import com.ai.ui.support.flows.invoice.RegisteredInvoiceFlow;
+import com.ai.ui.support.validation.invoice.AccountInvoiceValidation;
+import com.ai.ui.tests.fixture.invoice.RegisteredInvoiceFixture;
+import org.testng.annotations.Test;
+
+public final class RegisteredInvoiceDocumentContractTest extends BaseTestUI {
+    private final RegisteredInvoiceFlow uiFlow = new RegisteredInvoiceFlow();
+    private final RegisteredInvoiceFixture documentFixture = new RegisteredInvoiceFixture();
+    private final AccountInvoiceValidation documentValidation = new AccountInvoiceValidation();
+
+    @Test
+    public void invoice_document_response_method_is_get() {
+        documentValidation.assertInvoiceDocumentResponseMethodIsGet(documentFixture.createdInvoiceDocument());
+    }
+
+    @Test
+    public void invoice_document_status_body_is_json() {
+        documentValidation.assertInvoiceDocumentStatusBodyIsJson(documentFixture.createdInvoiceDocument());
+        documentValidation.assertInvoicePdfArtifactHasBinaryBoundaries(documentFixture.createdInvoiceDocument());
+    }
+
+    @Test
+    public void invoice_document_response_is_invoice_scoped_after_reopen() {
+        documentValidation.assertInvoiceDocumentResponseNamesInvoice(documentFixture.reopenedInvoiceDocument());
+    }
+
+    @Test
+    public void invoice_document_status_is_reported_after_relogin() {
+        documentValidation.assertInvoiceDocumentStatusBodyReportsState(documentFixture.reloggedInvoiceDocument());
+    }
+
+    @Test
+    public void invoice_document_details_keep_payment_after_reopen() {
+        documentValidation.assertInvoiceDocumentDetailsKeepPaymentMethod(documentFixture.reopenedInvoiceDocument());
+    }
+}
