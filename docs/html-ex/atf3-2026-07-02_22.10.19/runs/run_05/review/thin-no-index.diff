+package com.endava.ai.ui.tests.invoice.account.document;
+
+import com.endava.ai.ui.core.runtime.BaseTestUI;
+import com.endava.ai.ui.support.flows.invoice.RegisteredInvoiceFlow;
+import com.endava.ai.ui.support.validation.invoice.AccountInvoiceValidation;
+import com.endava.ai.ui.tests.fixture.invoice.RegisteredInvoiceFixture;
+import org.testng.annotations.Test;
+
+public final class RegisteredInvoiceDocumentReopenTest extends BaseTestUI {
+    private final RegisteredInvoiceFlow uiFlow = new RegisteredInvoiceFlow();
+    private final RegisteredInvoiceFixture documentFixture = new RegisteredInvoiceFixture();
+    private final AccountInvoiceValidation documentValidation = new AccountInvoiceValidation();
+
+    @Test
+    public void reopened_invoice_document_stays_details_scoped() {
+        documentValidation.assertInvoiceDetailsScopeDocument(documentFixture.reopenedInvoiceDocument());
+    }
+
+    @Test
+    public void reopened_document_download_response_is_successful() {
+        documentValidation.assertInvoiceDocumentResponseIsSuccessful(documentFixture.reopenedInvoiceDocument());
+        documentValidation.assertInvoicePdfArtifactHasBinaryBoundaries(documentFixture.reopenedInvoiceDocument());
+    }
+
+    @Test
+    public void reopened_document_download_url_is_invoice_scoped() {
+        documentValidation.assertInvoiceDocumentUrlIsInvoiceScoped(documentFixture.reopenedInvoiceDocument());
+    }
+
+    @Test
+    public void reopened_document_download_status_is_reported() {
+        documentValidation.assertInvoiceDocumentStatusBodyReportsState(documentFixture.reopenedInvoiceDocument());
+    }
+
+    @Test
+    public void reopened_invoice_document_details_keep_product() {
+        documentValidation.assertInvoiceDocumentDetailsKeepProduct(documentFixture.reopenedInvoiceDocument());
+    }
+}
