+package com.endava.ai.ui.support.flows.invoice;
+
+import com.endava.ai.ui.core.engine.UiNetworkResponse;
+import com.endava.ai.ui.support.actions.UIActions;
+import com.endava.ai.ui.support.model.CustomerData;
+import com.endava.ai.ui.support.pages.CheckoutPage;
+import com.endava.ai.ui.support.wait.WaitUtils;
+
+import java.time.Duration;
+import java.util.regex.Pattern;
+
+final class RegisteredInvoicePaymentConfirmationStep {
+    private static final Pattern INVOICE_PATTERN = Pattern.compile("INV-\\d+");
+    private static final String PAYMENT_METHOD = "Cash on Delivery";
+    private static final String PAYMENT_METHOD_VALUE = "cash-on-delivery";
+    private static final Duration INVOICE_CONFIRMATION_WAIT = Duration.ofSeconds(30);
+    private static final Duration INVOICE_CONFIRMATION_RETRY_WAIT = Duration.ofSeconds(15);
+
+    private final RegisteredInvoicePageState pageState = new RegisteredInvoicePageState();
+
+    String paymentMethod() {
+        return PAYMENT_METHOD;
+    }
+
+    String confirm(CustomerData customer, RegisteredInvoiceAccountActions accountActions) {
+        UIActions.select(CheckoutPage.PAYMENT_METHOD, "Payment method", PAYMENT_METHOD_VALUE);
+        WaitUtils.pause(Duration.ofMillis(300));
+        UIActions.click(CheckoutPage.FINISH, "Confirm payment method");
+        WaitUtils.waitForCondition(
+                "payment success message appears before final invoice confirmation",
+                () -> pageState.body().contains("Payment was successful"),
+                "Expected payment success message before final invoice confirmation. Current body: " + pageState.body()
+        );
+        UIActions.getText(CheckoutPage.BODY, "Checkout body after payment success");
+        if (pageState.isVisible(CheckoutPage.FINISH)) {
+            confirmInvoiceCreation();
+        }
+        Boolean invoiceVisible = waitForInvoiceNumber(INVOICE_CONFIRMATION_WAIT);
+        if (!Boolean.TRUE.equals(invoiceVisible) && pageState.isVisible(CheckoutPage.FINISH)) {
+            UIActions.click(CheckoutPage.FINISH, "Retry invoice confirmation");
+            invoiceVisible = waitForInvoiceNumber(INVOICE_CONFIRMATION_RETRY_WAIT);
+        }
+        if (!Boolean.TRUE.equals(invoiceVisible) && pageState.isVisible(CheckoutPage.FINISH)) {
+            UIActions.pressKey(CheckoutPage.FINISH, "Submit invoice confirmation with keyboard", "Enter");
+            invoiceVisible = waitForInvoiceNumber(INVOICE_CONFIRMATION_RETRY_WAIT);
+        }
+        if (!Boolean.TRUE.equals(invoiceVisible)) {
+            UIActions.getText(CheckoutPage.BODY, "Checkout body before account invoice fallback");
+            accountActions.openInvoicesFor(customer);
+            return accountActions.readInvoiceNumberFromAccountInvoices();
+        }
+        return accountActions.readInvoiceNumberFromCurrentPage("checkout confirmation");
+    }
+
+    private void confirmInvoiceCreation() {
+        WaitUtils.pause(Duration.ofSeconds(1));
+        UiNetworkResponse invoiceResponse = UIActions.waitForResponse(
+                "invoice creation after payment success",
+                "/invoices",
+                "POST",
+                () -> UIActions.click(CheckoutPage.FINISH, "Confirm payment into invoice")
+        );
+        if (!invoiceResponse.isSuccess()) {
+            throw new AssertionError("Expected invoice creation response to be successful, but status was "
+                    + invoiceResponse.getStatus() + " for " + invoiceResponse.getUrl()
+                    + ". Response body preview: " + invoiceResponse.getBodyPreview());
+        }
+        UIActions.getText(CheckoutPage.BODY, "Checkout body after final invoice confirmation");
+    }
+
+    private Boolean waitForInvoiceNumber(Duration timeout) {
+        return WaitUtils.waitUntil(
+                () -> INVOICE_PATTERN.matcher(pageState.body()).find(),
+                Boolean.TRUE::equals,
+                timeout,
+                Duration.ofMillis(500)
+        );
+    }
+}
