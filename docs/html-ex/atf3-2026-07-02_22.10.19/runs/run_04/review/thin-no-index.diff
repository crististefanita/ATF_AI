+package com.ai.ui.support.flows.invoice;
+
+import com.ai.ui.support.factory.CustomerDataFactory;
+import com.ai.ui.support.model.CustomerData;
+import com.ai.ui.support.pages.AccountPage;
+import com.ai.ui.support.pages.LoginPage;
+import com.ai.ui.support.service.RegistrationService;
+import com.ai.ui.support.actions.UIActions;
+import com.ai.ui.support.wait.WaitUtils;
+import com.ai.ui.support.validation.RegistrationValidation;
+
+import java.time.Duration;
+
+final class RegisteredInvoiceSessionActions {
+    private final RegistrationService registrationService = new RegistrationService();
+    private final RegistrationValidation registrationValidation = new RegistrationValidation();
+    private final RegisteredInvoicePageState pageState = new RegisteredInvoicePageState();
+
+    CustomerData registerCustomer() {
+        AssertionError lastFailure = null;
+        for (int attempt = 1; attempt <= 3; attempt++) {
+            CustomerData customer = CustomerDataFactory.validCustomer();
+            try {
+                registrationService.openRegister();
+                registrationService.register(customer);
+                registrationValidation.assertRedirectedToLogin();
+                return customer;
+            } catch (AssertionError failure) {
+                lastFailure = failure;
+                UIActions.clearSession();
+            }
+        }
+        throw lastFailure == null ? new AssertionError("Registration did not produce a customer.") : lastFailure;
+    }
+
+    void login(CustomerData customer) {
+        AssertionError lastFailure = null;
+        for (int attempt = 1; attempt <= 3; attempt++) {
+            try {
+                UIActions.openRelativeWithoutUrlWait("/auth/login");
+                WaitUtils.waitForVisible(LoginPage.EMAIL);
+                UIActions.type(LoginPage.EMAIL, "Registered customer email", customer.getEmail());
+                UIActions.type(LoginPage.PASSWORD, "Registered customer password", customer.getPassword());
+                UIActions.click(LoginPage.LOGIN_BUTTON, "Login registered customer");
+                WaitUtils.waitForCondition(
+                        "account surface is visible after registered login attempt " + attempt,
+                        () -> pageState.isVisible(AccountPage.NAV_MENU)
+                                || pageState.isVisible(AccountPage.PROFILE_NAV),
+                        "Expected login to expose the account surface.",
+                        Duration.ofSeconds(30)
+                );
+                return;
+            } catch (AssertionError failure) {
+                lastFailure = failure;
+                UIActions.clearSession();
+                WaitUtils.pause(Duration.ofSeconds(1));
+            }
+        }
+        throw lastFailure == null ? new AssertionError("Registered login did not reach account surface.") : lastFailure;
+    }
+}
+
