+package com.ai.ui.tests.invoice.account.document;
+
+import com.ai.ui.core.runtime.BaseTestUI;
+import com.ai.ui.support.flows.invoice.RegisteredInvoiceFlow;
+import com.ai.ui.support.validation.invoice.AccountInvoiceValidation;
+import com.ai.ui.tests.fixture.invoice.RegisteredInvoiceFixture;
+import org.testng.annotations.Test;
+
+public final class RegisteredInvoiceDocumentReloginTest extends BaseTestUI {
+    private final RegisteredInvoiceFlow uiFlow = new RegisteredInvoiceFlow();
+    private final RegisteredInvoiceFixture documentFixture = new RegisteredInvoiceFixture();
+    private final AccountInvoiceValidation documentValidation = new AccountInvoiceValidation();
+
+    @Test
+    public void relogged_invoice_document_stays_details_scoped() {
+        documentValidation.assertInvoiceDetailsScopeDocument(documentFixture.reloggedInvoiceDocument());
+    }
+
+    @Test
+    public void relogged_document_download_response_is_successful() {
+        documentValidation.assertInvoiceDocumentResponseIsSuccessful(documentFixture.reloggedInvoiceDocument());
+        documentValidation.assertInvoicePdfArtifactHasBinaryBoundaries(documentFixture.reloggedInvoiceDocument());
+    }
+
+    @Test
+    public void relogged_document_download_url_is_invoice_scoped() {
+        documentValidation.assertInvoiceDocumentUrlIsInvoiceScoped(documentFixture.reloggedInvoiceDocument());
+    }
+
+    @Test
+    public void relogged_document_download_status_is_reported() {
+        documentValidation.assertInvoiceDocumentStatusBodyReportsState(documentFixture.reloggedInvoiceDocument());
+    }
+
+    @Test
+    public void relogged_invoice_document_details_keep_total() {
+        documentValidation.assertInvoiceDocumentDetailsKeepTotal(documentFixture.reloggedInvoiceDocument());
+    }
+}
