+package com.ai.ui.support.flows.invoice;
+
+import com.ai.ui.support.model.invoice.AccountInvoiceSnapshot;
+import com.ai.ui.support.model.invoice.AccountInvoiceDocumentSnapshot;
+import com.ai.ui.support.model.CustomerData;
+import com.ai.ui.support.pages.AccountPage;
+import com.ai.ui.support.actions.UIActions;
+import com.ai.ui.support.wait.WaitUtils;
+
+public class RegisteredInvoiceFlow {
+    private final RegisteredInvoiceSessionActions sessionActions = new RegisteredInvoiceSessionActions();
+    private final RegisteredInvoiceAccountActions accountActions = new RegisteredInvoiceAccountActions(sessionActions);
+    private final RegisteredInvoiceCheckoutActions checkoutActions = new RegisteredInvoiceCheckoutActions();
+
+    public AccountInvoiceSnapshot createInvoiceAndOpenAccountInvoices() {
+        UIActions.clearSession();
+        CustomerData customer = sessionActions.registerCustomer();
+        sessionActions.login(customer);
+        RegisteredInvoiceCheckoutActions.ProductSelection product = checkoutActions.addFirstAvailableProduct();
+        String cartTotal = checkoutActions.proceedFromCartToSignInStep();
+        checkoutActions.proceedFromAuthenticatedSignInStep(customer);
+        checkoutActions.fillBilling(customer);
+        String invoiceNumber = checkoutActions.confirmPaymentToInvoice(customer, accountActions);
+        accountActions.openInvoices();
+        return new AccountInvoiceSnapshot(customer, product.name, product.unitPrice, product.quantity,
+                cartTotal, checkoutActions.paymentMethod(), invoiceNumber);
+    }
+
+    public void reopenAccountInvoices() {
+        UIActions.navigateToRelative("/account");
+        WaitUtils.waitForVisible(AccountPage.NAV_MENU);
+        accountActions.openInvoices();
+    }
+
+    public void reloginAndOpenAccountInvoices(AccountInvoiceSnapshot snapshot) {
+        // Session reset plus fresh login is the audited relogin boundary for the account invoice row.
+        UIActions.clearSession();
+        sessionActions.login(snapshot.getCustomer());
+        accountActions.openInvoices();
+    }
+
+    public void openInvoicesFor(AccountInvoiceSnapshot snapshot) {
+        accountActions.openInvoicesFor(snapshot);
+    }
+
+    public AccountInvoiceDocumentSnapshot openInvoiceDocument(AccountInvoiceSnapshot snapshot) {
+        return accountActions.openInvoiceDocument(snapshot);
+    }
+
+    public AccountInvoiceDocumentSnapshot openInvoiceDocumentStatus(AccountInvoiceSnapshot snapshot) {
+        return accountActions.openInvoiceDocumentStatus(snapshot);
+    }
+}
