+package com.ai.ui.support.flows.invoice;
+
+import com.ai.ui.support.actions.UIActions;
+import com.ai.ui.support.model.CustomerData;
+import com.ai.ui.support.pages.CheckoutPage;
+import com.ai.ui.support.wait.WaitUtils;
+
+import java.time.Duration;
+
+final class RegisteredInvoiceBillingStep {
+    private final RegisteredInvoicePageState pageState = new RegisteredInvoicePageState();
+
+    void fill(CustomerData customer) {
+        WaitUtils.waitForVisible(CheckoutPage.COUNTRY);
+        for (BillingField field : BillingField.values()) {
+            if (field == BillingField.CITY || field == BillingField.STATE) {
+                continue;
+            }
+            field.apply(customer);
+        }
+        UIActions.click(CheckoutPage.PROCEED_FROM_BILLING, "Proceed from billing to payment");
+        Boolean paymentVisible = WaitUtils.waitUntil(
+                () -> pageState.isVisible(CheckoutPage.PAYMENT_METHOD),
+                Boolean.TRUE::equals,
+                Duration.ofSeconds(10),
+                Duration.ofMillis(500)
+        );
+        if (!Boolean.TRUE.equals(paymentVisible) && pageState.isVisible(CheckoutPage.PROCEED_FROM_BILLING)) {
+            UIActions.click(CheckoutPage.PROCEED_FROM_BILLING, "Retry billing proceed");
+        }
+        WaitUtils.waitForVisible(CheckoutPage.PAYMENT_METHOD);
+    }
+
+    private static void typeFresh(String selector, String description, String value) {
+        UIActions.pressKey(selector, description + " select all", "Control+A");
+        UIActions.pressKey(selector, description + " clear", "Backspace");
+        UIActions.type(selector, description, value);
+    }
+
+    private enum BillingField {
+        COUNTRY(CheckoutPage.COUNTRY, "Billing country", CustomerData::getCountry, true),
+        POSTAL_CODE(CheckoutPage.POSTAL_CODE, "Billing postal code", CustomerData::getPostalCode, false),
+        HOUSE_NUMBER(CheckoutPage.HOUSE_NUMBER, "Billing house number", CustomerData::getHouseNumber, false),
+        STREET(CheckoutPage.STREET, "Billing street", CustomerData::getStreet, false),
+        CITY(CheckoutPage.CITY, "Billing city", CustomerData::getCity, false),
+        STATE(CheckoutPage.STATE, "Billing state", CustomerData::getState, false);
+
+        private final String selector;
+        private final String description;
+        private final java.util.function.Function<CustomerData, String> value;
+        private final boolean select;
+
+        BillingField(String selector,
+                     String description,
+                     java.util.function.Function<CustomerData, String> value,
+                     boolean select) {
+            this.selector = selector;
+            this.description = description;
+            this.value = value;
+            this.select = select;
+        }
+
+        private void apply(CustomerData customer) {
+            String fieldValue = value.apply(customer);
+            if (select) {
+                UIActions.select(selector, description, fieldValue);
+                return;
+            }
+            typeFresh(selector, description, fieldValue);
+        }
+    }
+}
