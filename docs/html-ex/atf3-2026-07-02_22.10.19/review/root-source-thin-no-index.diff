+package com.ai.ui.support.flows.invoice;
+
+import com.ai.ui.core.runtime.DriverManager;
+
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+final class RegisteredInvoicePageState {
+    private static final Pattern MONEY_PATTERN = Pattern.compile("\\$\\d+(?:\\.\\d{2})?");
+
+    String body() {
+        return DriverManager.getEngine().getText("body");
+    }
+
+    boolean isVisible(String selector) {
+        try {
+            return DriverManager.getEngine().isVisible(selector);
+        } catch (RuntimeException exception) {
+            return false;
+        }
+    }
+
+    boolean textContains(String selector, String expected) {
+        try {
+            return DriverManager.getEngine().getText(selector).contains(expected);
+        } catch (RuntimeException exception) {
+            return false;
+        }
+    }
+
+    String lastMoneyValue(String text) {
+        Matcher matcher = MONEY_PATTERN.matcher(text);
+        String value = "";
+        while (matcher.find()) {
+            value = matcher.group();
+        }
+        if (value.isEmpty()) {
+            throw new AssertionError("Cart total was not visible before checkout sign-in.");
+        }
+        return value;
+    }
+}
