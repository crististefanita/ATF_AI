+package com.ai.ui.support.validation.invoice;
+
+import com.ai.core.reporting.StepLogger;
+import com.ai.ui.support.model.invoice.AccountInvoiceSnapshot;
+import org.testng.Assert;
+
+import java.util.regex.Pattern;
+
+final class AccountInvoiceRowValidation {
+    private static final Pattern INVOICE_NUMBER = Pattern.compile("INV-\\d+");
+    private static final Pattern MONEY = Pattern.compile("\\d+(?:\\.\\d{2})?");
+
+    private final AccountInvoiceValidationSupport support = new AccountInvoiceValidationSupport();
+
+    void assertInvoiceNumberFormat(AccountInvoiceSnapshot snapshot) {
+        support.start(AccountInvoiceEvidence.IDENTITY_FORMAT);
+        StepLogger.logDetail("invoiceNumber=" + snapshot.getInvoiceNumber());
+        Assert.assertTrue(INVOICE_NUMBER.matcher(snapshot.getInvoiceNumber()).matches(),
+                "Expected invoice number format INV-nnn, but was: " + snapshot.getInvoiceNumber());
+        support.pass(AccountInvoiceEvidence.IDENTITY_FORMAT);
+    }
+
+    void assertInvoiceRowContainsCreatedInvoice(AccountInvoiceSnapshot snapshot) {
+        support.start(AccountInvoiceEvidence.CREATED_ROW_VISIBLE);
+        String body = support.invoicesBody();
+        StepLogger.logDetail("invoiceNumber=" + snapshot.getInvoiceNumber());
+        StepLogger.logDetail("invoicesBody=" + body);
+        support.assertContains(body, snapshot.getInvoiceNumber(),
+                "Expected account invoices page to list created invoice: " + snapshot.getInvoiceNumber());
+        support.pass(AccountInvoiceEvidence.CREATED_ROW_VISIBLE);
+    }
+
+    void assertInvoiceRowKeepsCheckoutTotal(AccountInvoiceSnapshot snapshot) {
+        support.start(AccountInvoiceEvidence.CHECKOUT_TOTAL_VISIBLE);
+        String body = support.invoicesBody();
+        StepLogger.logDetail("cartTotal=" + snapshot.getCartTotal());
+        StepLogger.logDetail("invoicesBody=" + body);
+        support.assertContains(body, snapshot.getCartTotal(),
+                "Expected account invoice row to contain checkout total: " + snapshot.getCartTotal());
+        support.pass(AccountInvoiceEvidence.CHECKOUT_TOTAL_VISIBLE);
+    }
+
+    void assertInvoiceTableShape(AccountInvoiceSnapshot snapshot) {
+        support.start(AccountInvoiceEvidence.TABLE_CONTRACT);
+        String body = support.invoicesBody();
+        StepLogger.logDetail("invoiceNumber=" + snapshot.getInvoiceNumber());
+        support.assertContainsAll(body, "Expected account invoices table shape.",
+                "Invoices", "Invoice Number", "Invoice Date", "Total", "Details");
+        support.pass(AccountInvoiceEvidence.TABLE_CONTRACT);
+    }
+
+    void assertInvoiceBelongsToRegisteredCustomer(AccountInvoiceSnapshot snapshot) {
+        support.start(AccountInvoiceEvidence.REGISTERED_OWNERSHIP);
+        String body = support.invoicesBody();
+        StepLogger.logDetail("customerEmail=" + snapshot.getCustomer().getEmail());
+        StepLogger.logDetail("invoiceNumber=" + snapshot.getInvoiceNumber());
+        support.assertContains(body, snapshot.getInvoiceNumber(), "Expected logged account to expose its invoice number.");
+        Assert.assertFalse(body.toLowerCase().contains("no invoices"),
+                "Expected invoice collection not to be empty for the created invoice.");
+        support.pass(AccountInvoiceEvidence.REGISTERED_OWNERSHIP);
+    }
+
+    void assertInvoiceSnapshotKeepsProductIdentity(AccountInvoiceSnapshot snapshot) {
+        support.start(AccountInvoiceEvidence.PRODUCT_IDENTITY);
+        StepLogger.logDetail("productName=" + snapshot.getProductName());
+        Assert.assertFalse(snapshot.getProductName().isBlank(), "Expected selected product name to be captured.");
+        support.pass(AccountInvoiceEvidence.PRODUCT_IDENTITY);
+    }
+
+    void assertInvoiceSnapshotKeepsUnitPrice(AccountInvoiceSnapshot snapshot) {
+        support.start(AccountInvoiceEvidence.UNIT_PRICE);
+        StepLogger.logDetail("unitPrice=" + snapshot.getProductUnitPrice());
+        Assert.assertTrue(MONEY.matcher(snapshot.getProductUnitPrice()).matches(),
+                "Expected product unit price captured from UI, but was: " + snapshot.getProductUnitPrice());
+        support.pass(AccountInvoiceEvidence.UNIT_PRICE);
+    }
+
+    void assertInvoiceSnapshotKeepsQuantity(AccountInvoiceSnapshot snapshot) {
+        support.start(AccountInvoiceEvidence.CHECKOUT_QUANTITY);
+        StepLogger.logDetail("quantity=" + snapshot.getQuantity());
+        Assert.assertEquals(snapshot.getQuantity(), 1, "Expected single product checkout quantity.");
+        support.pass(AccountInvoiceEvidence.CHECKOUT_QUANTITY);
+    }
+
+    void assertInvoiceSnapshotKeepsPaymentMethod(AccountInvoiceSnapshot snapshot) {
+        support.start(AccountInvoiceEvidence.PAYMENT_METHOD);
+        StepLogger.logDetail("paymentMethod=" + snapshot.getPaymentMethod());
+        Assert.assertEquals(snapshot.getPaymentMethod(), "Cash on Delivery", "Expected cash on delivery payment.");
+        support.pass(AccountInvoiceEvidence.PAYMENT_METHOD);
+    }
+}
