+package com.ai.ui.support.validation.invoice;
+
+enum AccountInvoiceEvidence {
+    IDENTITY_FORMAT("Validate invoice number is a durable business identity", "Invoice number has durable business format"),
+    CREATED_ROW_VISIBLE("Validate account invoice row contains created invoice", "Created invoice is listed in the account invoices table"),
+    CHECKOUT_TOTAL_VISIBLE("Validate account invoice row keeps checkout total", "Account invoice row keeps checkout total"),
+    TABLE_CONTRACT("Validate account invoices table shape", "Account invoices table exposes row identity, date, total and details"),
+    REGISTERED_OWNERSHIP("Validate invoice is owned by registered account surface", "Invoice row belongs to the registered account surface"),
+    PRODUCT_IDENTITY("Validate invoice snapshot keeps product identity captured from UI", "Invoice snapshot keeps selected product identity."),
+    UNIT_PRICE("Validate invoice snapshot keeps product unit price captured from UI", "Invoice snapshot keeps selected product unit price."),
+    CHECKOUT_QUANTITY("Validate invoice snapshot keeps checkout quantity", "Invoice snapshot keeps single product quantity."),
+    PAYMENT_METHOD("Validate invoice snapshot keeps payment method", "Invoice snapshot keeps payment method."),
+    DOCUMENT_DETAILS_SCOPE("Validate invoice document starts from invoice details", "Invoice details scope owns document trigger."),
+    DOCUMENT_RESPONSE_STATUS("Validate invoice document status boundary is reachable", "Invoice document status boundary is reachable."),
+    DOCUMENT_URL_SCOPE("Validate invoice document URL remains invoice scoped", "Invoice document URL remains invoice scoped."),
+    DOCUMENT_GENERATION_COMPLETED("Validate invoice PDF generation status is observable", "Invoice PDF generation lifecycle state is observable."),
+    DOCUMENT_DETAILS_INVOICE_IDENTITY("Validate invoice document details name the invoice", "Invoice document details name the invoice."),
+    DOCUMENT_LIST_PRECONDITION("Validate invoice list owns row before document download", "Invoice list owns row before document download."),
+    DOCUMENT_DETAILS_PRODUCT("Validate invoice document details keep product identity", "Invoice document details keep product identity."),
+    DOCUMENT_DETAILS_TOTAL("Validate invoice document details keep checkout total", "Invoice document details keep checkout total."),
+    DOCUMENT_DETAILS_PAYMENT("Validate invoice document details keep payment method", "Invoice document details keep payment method."),
+    DOCUMENT_RESPONSE_METHOD("Validate invoice document response method", "Invoice document response method is GET."),
+    DOCUMENT_RESPONSE_INVOICE_SCOPE("Validate invoice document response names invoice", "Invoice document response names invoice."),
+    DOCUMENT_RESPONSE_JSON_STATUS("Validate invoice document status body", "Invoice document status body exposes JSON lifecycle status."),
+    DOCUMENT_RESPONSE_REPORTED_STATUS("Validate invoice document reported status body", "Invoice document status body reports a lifecycle state."),
+    DOCUMENT_PDF_ARTIFACT("Validate invoice PDF generation boundary", "Invoice PDF generation boundary exposes invoice-scoped status.");
+
+    final String startMessage;
+    final String passMessage;
+
+    AccountInvoiceEvidence(String startMessage, String passMessage) {
+        this.startMessage = startMessage;
+        this.passMessage = passMessage;
+    }
+}
