+package com.ai.ui.support.flows.invoice;
+
+import com.ai.ui.support.model.CustomerData;
+import com.ai.ui.support.pages.CheckoutPage;
+import com.ai.ui.support.pages.LoginPage;
+import com.ai.ui.support.pages.ProductPage;
+import com.ai.ui.support.actions.UIActions;
+import com.ai.ui.support.wait.WaitUtils;
+
+import java.time.Duration;
+
+final class RegisteredInvoiceCheckoutActions {
+    private final RegisteredInvoicePageState pageState = new RegisteredInvoicePageState();
+    private final RegisteredInvoiceBillingStep billingStep = new RegisteredInvoiceBillingStep();
+    private final RegisteredInvoicePaymentConfirmationStep paymentConfirmationStep =
+            new RegisteredInvoicePaymentConfirmationStep();
+
+    String paymentMethod() {
+        return paymentConfirmationStep.paymentMethod();
+    }
+
+    ProductSelection addFirstAvailableProduct() {
+        UIActions.navigateToRelative("/");
+        WaitUtils.waitForVisible(ProductPage.PRODUCT_CARD);
+        int count = UIActions.getTexts(ProductPage.PRODUCT_CARD, "Catalog product links").size();
+        for (int index = 1; index <= count; index++) {
+            String cardText = UIActions.getTexts(ProductPage.PRODUCT_CARD, "Catalog product links").get(index - 1);
+            if (cardText.toLowerCase().contains("out of stock")) {
+                continue;
+            }
+            UIActions.clickVisible(ProductPage.PRODUCT_CARD, "Available catalog product", index);
+            WaitUtils.waitForVisible(ProductPage.PRODUCT_NAME);
+            String productName = UIActions.getText(ProductPage.PRODUCT_NAME, "Product detail name");
+            String unitPrice = UIActions.getText(ProductPage.UNIT_PRICE, "Product unit price");
+            UIActions.click(ProductPage.ADD_TO_CART, "Add product to cart");
+            waitForCartReadyAfterAdd();
+            return new ProductSelection(productName, unitPrice, 1);
+        }
+        throw new AssertionError("No in-stock catalog product was available for invoice checkout.");
+    }
+
+    private void waitForCartReadyAfterAdd() {
+        Boolean cartUpdated = waitForCartBadge();
+        if (!Boolean.TRUE.equals(cartUpdated)) {
+            UIActions.click(ProductPage.ADD_TO_CART, "Retry add product to cart");
+            cartUpdated = waitForCartBadge();
+        }
+        if (Boolean.TRUE.equals(cartUpdated)) {
+            return;
+        }
+        UIActions.navigateToRelative("/checkout");
+        WaitUtils.waitForVisible(CheckoutPage.PROCEED_FROM_CART);
+    }
+
+    private Boolean waitForCartBadge() {
+        return WaitUtils.waitUntil(
+                () -> pageState.textContains(ProductPage.CART_QUANTITY, "1"),
+                Boolean.TRUE::equals,
+                Duration.ofSeconds(10),
+                Duration.ofMillis(500)
+        );
+    }
+
+    String proceedFromCartToSignInStep() {
+        UIActions.navigateToRelative("/checkout");
+        WaitUtils.waitForVisible(CheckoutPage.PROCEED_FROM_CART);
+        String cartBody = pageState.body();
+        UIActions.click(CheckoutPage.PROCEED_FROM_CART, "Proceed from cart to sign-in step");
+        return pageState.lastMoneyValue(cartBody);
+    }
+
+    void proceedFromAuthenticatedSignInStep(CustomerData customer) {
+        WaitUtils.waitForCondition(
+                "authenticated checkout sign-in step is ready",
+                () -> pageState.body().contains("already logged in") || pageState.isVisible(LoginPage.EMAIL),
+                "Expected checkout sign-in step before billing."
+        );
+        if (pageState.isVisible(LoginPage.EMAIL)) {
+            UIActions.type(LoginPage.EMAIL, "Checkout login email", customer.getEmail());
+            UIActions.type(LoginPage.PASSWORD, "Checkout login password", customer.getPassword());
+            UIActions.click(LoginPage.LOGIN_BUTTON, "Checkout login");
+        }
+        WaitUtils.waitForVisible(CheckoutPage.PROCEED_FROM_ACCOUNT);
+        UIActions.click(CheckoutPage.PROCEED_FROM_ACCOUNT, "Proceed from authenticated sign-in");
+    }
+
+    void fillBilling(CustomerData customer) {
+        billingStep.fill(customer);
+    }
+
+    String confirmPaymentToInvoice(CustomerData customer, RegisteredInvoiceAccountActions accountActions) {
+        return paymentConfirmationStep.confirm(customer, accountActions);
+    }
+
+    static final class ProductSelection {
+        final String name;
+        final String unitPrice;
+        final int quantity;
+
+        private ProductSelection(String name, String unitPrice, int quantity) {
+            this.name = name;
+            this.unitPrice = unitPrice;
+            this.quantity = quantity;
+        }
+    }
+
+}
+
