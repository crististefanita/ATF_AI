+package com.endava.ai.ui.tests;
+
+import com.endava.ai.ui.actions.ContactMessageActions;
+import com.endava.ai.ui.core.BaseTestUI;
+import com.endava.ai.ui.model.ContactMessageContext;
+import com.endava.ai.ui.validation.ContactMessageValidation;
+import org.testng.annotations.Test;
+
+public class ContactMessageRun03ReopenTests extends BaseTestUI {
+    private final ContactMessageActions actions = new ContactMessageActions();
+    private final ContactMessageValidation validation = new ContactMessageValidation();
+
+    @Test
+    public void reopened_messages_page_keeps_support_row() {
+        ContactMessageContext context = actions.createMessageReopenMessages();
+        validation.assertReopenedMessagesStillContainRow(context);
+    }
+
+    @Test
+    public void reopened_messages_page_keeps_support_status() {
+        ContactMessageContext context = actions.createMessageReopenMessages();
+        validation.assertMessageStatusIsNew(context);
+    }
+
+    @Test
+    public void reopened_messages_page_keeps_timestamp() {
+        ContactMessageContext context = actions.createMessageReopenMessages();
+        validation.assertMessageDateIsVisible(context);
+    }
+
+    @Test
+    public void reopened_messages_details_keep_full_message() {
+        ContactMessageContext context = actions.createMessageReopenDetails();
+        validation.assertDetailsRouteOpensFromRow(context);
+    }
+
+    @Test
+    public void reopened_messages_details_keep_reply_surface() {
+        ContactMessageContext context = actions.createMessageReopenDetails();
+        validation.assertDetailsExposeReplySurface(context);
+    }
+}
