+
+    @Test
+    public void relogin_message_details_keep_full_message() {
+        ContactMessageContext context = actions.createMessageReloginAndOpenDetails();
+        validation.assertDetailsRouteOpensFromRow(context);
+    }
+
+    @Test
+    public void relogin_message_details_keep_customer_identity() {
+        ContactMessageContext context = actions.createMessageReloginAndOpenDetails();
+        validation.assertDetailsPreserveCustomerIdentity(context);
+    }
+
+    @Test
+    public void relogin_message_details_keep_subject_and_status() {
