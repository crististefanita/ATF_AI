<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ai</groupId>
    <artifactId>atf-parent</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>atf-governance</artifactId>
  <name>atf-governance</name>
  <dependencies>
    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
    </dependency>
    <dependency>
      <groupId>com.ai</groupId>
      <artifactId>atf-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ai</groupId>
      <artifactId>atf-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ai</groupId>
      <artifactId>atf-playwright</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ai</groupId>
      <artifactId>atf-selenium</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ai</groupId>
      <artifactId>atf-reporting</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <properties>
    <atf.governance.suite>src/test/resources/suites/framework-governance.xml</atf.governance.suite>
  </properties>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <failIfNoTests>true</failIfNoTests>
          <suiteXmlFiles>
            <suiteXmlFile>${atf.governance.suite}</suiteXmlFile>
          </suiteXmlFiles>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
