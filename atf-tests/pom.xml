<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ai</groupId>
    <artifactId>atf-parent</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>atf-tests</artifactId>
  <name>atf-tests</name>
  <dependencies>
    <dependency>
      <groupId>com.ai</groupId>
      <artifactId>atf-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ai</groupId>
      <artifactId>atf-playwright</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ai</groupId>
      <artifactId>atf-selenium</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ai</groupId>
      <artifactId>atf-reporting</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <properties>
    <atf.build.directory>${project.basedir}/target</atf.build.directory>
    <surefire.reportsDirectory>${project.build.directory}/surefire-reports</surefire.reportsDirectory>
    <atf.test.suite>src/test/resources/suites/framework-local.xml</atf.test.suite>
    <surefire.suiteXmlFiles>${atf.test.suite}</surefire.suiteXmlFiles>
  </properties>
  <build>
    <directory>${atf.build.directory}</directory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <reportsDirectory>${surefire.reportsDirectory}</reportsDirectory>
          <failIfNoTests>true</failIfNoTests>
          <suiteXmlFiles>
            <suiteXmlFile>${surefire.suiteXmlFiles}</suiteXmlFile>
          </suiteXmlFiles>
          <systemPropertyVariables>
            <framework.properties>framework.properties</framework.properties>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>browser</id>
      <properties>
        <atf.test.suite>src/test/resources/suites/framework-browser.xml</atf.test.suite>
      </properties>
    </profile>
    <profile>
      <id>aggregate</id>
      <properties>
        <atf.test.suite>src/test/resources/suites/framework-aggregate.xml</atf.test.suite>
        <atf.core.aggregate.report.engine>extent</atf.core.aggregate.report.engine>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <atf.core.aggregate.report.enabled>true</atf.core.aggregate.report.enabled>
                <atf.core.aggregate.report.engine>${atf.core.aggregate.report.engine}</atf.core.aggregate.report.engine>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
